{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightfall-worldwide",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Variables set in the Cloudflare dashboard survive deploys from the repo.
  // Without this, every Workers Builds deploy resets plain-text variables to
  // the (empty) list here. Secrets are never touched either way — RESEND_API_KEY
  // belongs in the dashboard as type Secret, never in this file.
  "keep_vars": true
  // When the domain moves off Squarespace, add:
  // "routes": [
  //   { "pattern": "nightfallworldwide.com", "custom_domain": true },
  //   { "pattern": "www.nightfallworldwide.com", "custom_domain": true }
  // ]
}
